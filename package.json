{
  "name": "test-amtrak",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven Playwright tests for Amtrak.com search",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:cross-browser": "playwright test --project=chrome --project=msedge --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.15.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^15.12.0",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
